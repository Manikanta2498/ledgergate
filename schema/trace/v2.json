    "OpenTransactionDoc": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/MoneyDoc"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "open_transaction",
          "default": "open_transaction",
          "title": "Kind",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 256,
          "minLength": 1,
