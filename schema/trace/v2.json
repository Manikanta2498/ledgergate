        }
      },
      "required": [
        "seq",
        "at",
        "command_id",
        "command"
      ],
      "title": "LedgerCommandEvent",
      "type": "object"
    },
    "LedgerResultEvent": {
      "additionalProperties": false,
      "description": "Shape depends on ``ok``; see the schema's ``ledger_result_body`` description.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "command_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Command Id",
          "type": "string"
        },
        "entry_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Id"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "head": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "posted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Posted At"
        },
        "replayed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replayed"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "type": {
          "const": "ledger_result",
          "default": "ledger_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "command_id",
        "ok"
      ],
      "title": "LedgerResultEvent",
      "type": "object"
    },
