        "at",
        "role",
        "content"
      ],
      "title": "MessageEvent",
      "type": "object"
    },
    "MoneyDoc": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "MoneyDoc",
      "type": "object"
