{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Manikanta2498/ledgergate/schema/trace/v1.json",
  "title": "LedgerGate execution trace, version 1",
  "description": "A normalized record of one agent run against a money-moving system: what the agent said and called, which ledger commands the system derived from that, and what the ledger did with them. Any agent that emits this document can be checked by the LedgerGate invariant suite, whatever framework produced it.\n\nConstraints JSON Schema cannot express, enforced by conforming consumers: (1) `seq` is strictly increasing; (2) every `ledger_command` has exactly one `ledger_result` with the same `command_id`, appearing after it, and there are no other results; (3) `command_id` values are unique; (4) every currency code used anywhere resolves to an entry in `currencies` or to one of the well-known codes the consumer bundles, and a declared code never contradicts a bundled exponent; (5) `currencies[].code` values are unique; (6) `chart[].account_id` values are unique.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "agent",
    "started_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "$ref": "#/$defs/identifier"
    },
    "scenario_id": {
      "$ref": "#/$defs/identifier"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "currencies": {
      "description": "Minor-unit exponents for every currency the trace uses. A code alone does not determine an exponent (JPY has 0, KWD has 3), so a trace that omits a currency's exponent cannot be replayed exactly. Consumers may bundle well-known codes; declaring them here is harmless and makes the trace self-contained.",
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/currency_def"
      }
    },
    "chart": {
      "description": "The chart of accounts the ledger commands were executed against. Required by any consumer that replays the commands.",
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "metadata": {
      "$ref": "#/$defs/string_map"
    }
  },
  "$defs": {
    "identifier": {
      "description": "Non-empty, no leading or trailing whitespace, and no line-break character of any kind (CR, LF, VT, FF, FS, GS, RS, NEL, LS, PS) or NUL.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\r\\n\\x0b\\x0c\\x1c\\x1d\\x1e\\x85\\u2028\\u2029\\x00](?:[^\\r\\n\\x0b\\x0c\\x1c\\x1d\\x1e\\x85\\u2028\\u2029\\x00]*[^\\s\\r\\n\\x0b\\x0c\\x1c\\x1d\\x1e\\x85\\u2028\\u2029\\x00])?$"
    },
    "short_text": {
      "type": "string",
      "maxLength": 1024
    },
    "long_text": {
      "type": "string",
      "maxLength": 65536
    },
    "string_map": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "currency_code": {
      "description": "ISO 4217 style alphabetic code.",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "currency_def": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "code",
        "exponent"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/currency_code"
        },
        "exponent": {
          "description": "Number of minor-unit digits: 2 for USD, 0 for JPY, 3 for KWD.",
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "money": {
      "description": "An exact amount in integer minor units of `currency`. There is deliberately no floating-point form; JSON Schema's `integer` admits `5.0` because the JSON data model has one number type, but conforming producers emit integers without a fractional part and the reference runtime rejects whole floats. The amount is not constrained to be positive here: a trace must be able to record an agent *attempting* a zero or negative amount, so the ledger's rejection of it can be replayed and checked.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "integer"
        },
        "currency": {
          "$ref": "#/$defs/currency_code"
        }
      }
    },
    "agent": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "model": {
          "$ref": "#/$defs/short_text"
        },
        "framework": {
          "$ref": "#/$defs/short_text"
        },
        "version": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "account": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "account_id",
        "kind",
        "currency"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "asset",
            "liability",
            "equity",
            "revenue",
            "expense"
          ]
        },
        "currency": {
          "$ref": "#/$defs/currency_code"
        },
        "allow_negative": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "posting": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "account",
        "side",
        "money"
      ],
      "properties": {
        "account": {
          "$ref": "#/$defs/identifier"
        },
        "side": {
          "enum": [
            "debit",
            "credit"
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "entry_draft": {
      "description": "A journal entry as proposed. Balance and posting positivity are the ledger's checks, replayed by consumers; the schema only requires at least two postings.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "postings"
      ],
      "properties": {
        "postings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/posting"
          }
        },
        "description": {
          "$ref": "#/$defs/short_text"
        },
        "tags": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "command": {
      "description": "A ledger command, one-to-one with `ledgergate.ledger` command types. Every command carries an idempotency key.",
      "type": "object",
      "required": [
        "kind",
        "key"
      ],
      "properties": {
        "kind": {
          "enum": [
            "post",
            "reverse",
            "open_transaction",
            "advance",
            "refund"
          ]
        },
        "key": {
          "$ref": "#/$defs/identifier"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "post"
            },
            "key": true,
            "draft": {
              "$ref": "#/$defs/entry_draft"
            }
          },
          "required": [
            "draft"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "reverse"
            },
            "key": true,
            "entry_id": {
              "$ref": "#/$defs/identifier"
            },
            "description": {
              "$ref": "#/$defs/short_text"
            }
          },
          "required": [
            "entry_id"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "open_transaction"
            },
            "key": true,
            "transaction_id": {
              "$ref": "#/$defs/identifier"
            },
            "amount": {
              "$ref": "#/$defs/money"
            }
          },
          "required": [
            "transaction_id",
            "amount"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "advance"
            },
            "key": true,
            "transaction_id": {
              "$ref": "#/$defs/identifier"
            },
            "event": {
              "enum": [
                "authorize",
                "settle",
                "dispute",
                "resolve_dispute",
                "cancel",
                "fail"
              ]
            },
            "entry": {
              "$ref": "#/$defs/entry_draft"
            }
          },
          "required": [
            "transaction_id",
            "event"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "refund"
            },
            "key": true,
            "transaction_id": {
              "$ref": "#/$defs/identifier"
            },
            "money": {
              "$ref": "#/$defs/money"
            },
            "entry": {
              "$ref": "#/$defs/entry_draft"
            }
          },
          "required": [
            "transaction_id",
            "money"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "event_base": {
      "type": "object",
      "required": [
        "seq",
        "at",
        "type"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "enum": [
            "message",
            "tool_call",
            "tool_result",
            "ledger_command",
            "ledger_result"
          ]
        }
      }
    },
    "ledger_result_body": {
      "description": "The outcome of one command. Shape depends on `ok`. Success: `replayed`, `head` and `sequence` are required, `error` is forbidden, and `entry_id`/`posted_at` are present together exactly when an entry was appended (never on a replay). Failure: `error`, `head` and `sequence` are required and describe the unchanged ledger; `replayed`, `entry_id` and `posted_at` are forbidden.",
      "oneOf": [
        {
          "properties": {
            "ok": {
              "const": true
            },
            "replayed": {
              "type": "boolean"
            },
            "head": {
              "description": "Hash-chain head after the command.",
              "$ref": "#/$defs/sha256"
            },
            "sequence": {
              "description": "Number of entries in the ledger after the command.",
              "type": "integer",
              "minimum": 0
            },
            "entry_id": {
              "description": "Id of the entry this command appended. Together with `posted_at` these are the effects the ledger consumed, and are what a replayer feeds back to reproduce `head` exactly.",
              "$ref": "#/$defs/identifier"
            },
            "posted_at": {
              "description": "Timestamp the ledger stamped on the appended entry.",
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "replayed",
            "head",
            "sequence"
          ],
          "dependentRequired": {
            "entry_id": [
              "posted_at"
            ],
            "posted_at": [
              "entry_id"
            ]
          },
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/error"
            },
            "head": {
              "description": "Hash-chain head, unchanged by the failed command.",
              "$ref": "#/$defs/sha256"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "error",
            "head",
            "sequence"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "replayed"
                ]
              },
              {
                "required": [
                  "entry_id"
                ]
              },
              {
                "required": [
                  "posted_at"
                ]
              }
            ]
          }
        }
      ]
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/event_base"
        }
      ],
      "oneOf": [
        {
          "properties": {
            "seq": true,
            "at": true,
            "type": {
              "const": "message"
            },
            "role": {
              "enum": [
                "system",
                "user",
                "assistant",
                "tool"
              ]
            },
            "content": {
              "$ref": "#/$defs/long_text"
            }
          },
          "required": [
            "role",
            "content"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "seq": true,
            "at": true,
            "type": {
              "const": "tool_call"
            },
            "call_id": {
              "$ref": "#/$defs/identifier"
            },
            "tool": {
              "$ref": "#/$defs/identifier"
            },
            "arguments": {
              "type": "object"
            },
            "idempotency_key": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "call_id",
            "tool",
            "arguments"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "seq": true,
            "at": true,
            "type": {
              "const": "tool_result"
            },
            "call_id": {
              "$ref": "#/$defs/identifier"
            },
            "ok": {
              "type": "boolean"
            },
            "result": {},
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "call_id",
            "ok"
          ],
          "unevaluatedProperties": false
        },
        {
          "properties": {
            "seq": true,
            "at": true,
            "type": {
              "const": "ledger_command"
            },
            "command_id": {
              "$ref": "#/$defs/identifier"
            },
            "call_id": {
              "description": "The tool call this command was derived from, if any.",
              "$ref": "#/$defs/identifier"
            },
            "command": {
              "$ref": "#/$defs/command"
            }
          },
          "required": [
            "command_id",
            "command"
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ledger_result_body"
            }
          ],
          "properties": {
            "seq": true,
            "at": true,
            "type": {
              "const": "ledger_result"
            },
            "command_id": {
              "$ref": "#/$defs/identifier"
            },
            "ok": {
              "type": "boolean"
            },
            "replayed": true,
            "error": true,
            "head": true,
            "sequence": true,
            "entry_id": true,
            "posted_at": true
          },
          "required": [
            "command_id",
            "ok"
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
