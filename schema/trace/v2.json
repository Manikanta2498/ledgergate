{
  "$comment": "See the TraceV2 docstring for the grammar consumers enforce.",
  "$defs": {
    "AccountDoc": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Account Id",
          "type": "string"
        },
        "allow_negative": {
          "default": true,
          "title": "Allow Negative",
          "type": "boolean"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "kind": {
          "enum": [
            "asset",
            "liability",
            "equity",
            "revenue",
            "expense"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "default": "",
          "maxLength": 1024,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "kind",
        "currency"
      ],
      "title": "AccountDoc",
      "type": "object"
    },
    "AdvanceDoc": {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryDraftDoc"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event": {
          "enum": [
            "authorize",
            "settle",
            "dispute",
            "resolve_dispute",
            "cancel",
            "fail"
          ],
          "title": "Event",
          "type": "string"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "const": "advance",
          "default": "advance",
          "title": "Kind",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Transaction Id",
          "type": "string"
        }
      },
      "required": [
        "key",
        "transaction_id",
        "event"
      ],
      "title": "AdvanceDoc",
      "type": "object"
    },
    "AgentDoc": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "AgentDoc",
      "type": "object"
    },
    "ApprovalRef": {
      "additionalProperties": false,
      "properties": {
        "presentation_ref": {
          "pattern": "^presentation-[1-9][0-9]*$",
          "title": "Presentation Ref",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "approval_valid",
            "approval_already_used",
            "approval_not_applicable",
            "approval_invalid",
            "approval_expired",
            "approval_scope_mismatch"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "presentation_ref",
        "verdict"
      ],
      "title": "ApprovalRef",
      "type": "object"
    },
    "CommandIntent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "call_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Call Id",
          "type": "string"
        },
        "command": {
          "discriminator": {
            "mapping": {
              "advance": "#/$defs/AdvanceDoc",
              "open_transaction": "#/$defs/OpenTransactionDoc",
              "post": "#/$defs/PostDoc",
              "refund": "#/$defs/RefundDoc",
              "reverse": "#/$defs/ReverseDoc"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PostDoc"
            },
            {
              "$ref": "#/$defs/ReverseDoc"
            },
            {
              "$ref": "#/$defs/OpenTransactionDoc"
            },
            {
              "$ref": "#/$defs/AdvanceDoc"
            },
            {
              "$ref": "#/$defs/RefundDoc"
            }
          ],
          "title": "Command"
        },
        "intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Intent Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "command_intent",
          "default": "command_intent",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "intent_id",
        "call_id",
        "command"
      ],
      "title": "CommandIntent",
      "type": "object"
    },
    "CurrencyDoc": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z]{3}$",
          "title": "Code",
          "type": "string"
        },
        "exponent": {
          "maximum": 6,
          "minimum": 0,
          "title": "Exponent",
          "type": "integer"
        }
      },
      "required": [
        "code",
        "exponent"
      ],
      "title": "CurrencyDoc",
      "type": "object"
    },
    "EntryDraftDoc": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "postings": {
          "items": {
            "$ref": "#/$defs/PostingDoc"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Postings",
          "type": "array"
        },
        "tags": {
          "additionalProperties": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxProperties": 100,
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "postings"
      ],
      "title": "EntryDraftDoc",
      "type": "object"
    },
    "ErrorDoc": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 1024,
          "title": "Message",
          "type": "string"
        },
        "type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorDoc",
      "type": "object"
    },
    "InvocationResolution": {
      "additionalProperties": false,
      "description": "Exactly one per invocation: what the runtime did with it.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "attempted_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempted Digest",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "new",
            "replay",
            "conflict",
            "approval",
            "read",
            "invalid",
            "legacy"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "intent_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Intent Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "outcome_ref": {
          "anyOf": [
            {
              "pattern": "^outcome-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Ref"
        },
        "presentation_ref": {
          "anyOf": [
            {
              "pattern": "^presentation-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Presentation Ref"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "invocation_resolution",
          "default": "invocation_resolution",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "at",
        "intent_id",
        "disposition",
        "attempted_digest"
      ],
      "title": "InvocationResolution",
      "type": "object"
    },
    "JsonValue": {},
    "LedgerCommandEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
