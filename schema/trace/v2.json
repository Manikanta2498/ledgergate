              "post": "#/$defs/PostDoc",
              "refund": "#/$defs/RefundDoc",
              "reverse": "#/$defs/ReverseDoc"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PostDoc"
            },
            {
              "$ref": "#/$defs/ReverseDoc"
            },
            {
              "$ref": "#/$defs/OpenTransactionDoc"
            },
            {
              "$ref": "#/$defs/AdvanceDoc"
            },
            {
              "$ref": "#/$defs/RefundDoc"
            }
          ],
          "title": "Command"
        },
        "command_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000](?:[^\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000]*[^\\s\r\n\u000b\f\u001c\u001d\u001e\u0085\u2028\u2029\u0000])?$",
          "title": "Command Id",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "ledger_command",
          "default": "ledger_command",
          "title": "Type",
